# ══════════════════════════════════════════════════════
# BRANDMINGO BACKEND — Environment Variables Example (VPS)
# ══════════════════════════════════════════════════════

# ── Server ──
# Port on which the Express server will listen (default: 5000)
PORT=5000

# ── Environment ──
# Set to 'production' on VPS
NODE_ENV=production

# ── Database ──
# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.djx2vdz.mongodb.net/brandmingo

# ── Auth ──
# Strong secret key for JWT signing
JWT_SECRET=your_super_strong_jwt_secret_here

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CORS ──
# Production URL (no trailing slash)
CLIENT_URL=https://brandmingo.com
